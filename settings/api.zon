.{
    .bind_address = "0.0.0.0",
    .port = 8080,
    .max_request_bytes = 1048576,
    .max_response_bytes = 8388608,
    .request_timeout_ms = 5000,
    .keep_alive_timeout_ms = 15000,
    .max_connections = 4096,
    .max_concurrent_requests = 2048,
    .default_result_count = 10,
    .max_result_count = 100,
    .default_deadline_ms = 100,
    .max_deadline_ms = 30000,
    .enable_highlights = true,
    .enable_entities = true,
    .enable_research = true,
    .default_highlight_count = 3,
    .max_highlight_count = 10,
    .entity_categories = .{ "organization", "person", "product", "technology", "funding_event", "research_publication", "date", "location" },
    .entity_category_count = 8,
    .shutdown_drain_ms = 5000,
    .health_dependency_timeout_ms = 1000,
    .metrics_include_histograms = true,
}
