{
    .frontend_threads = 8,
    .fetcher_threads = 16,
    .dial_timeout_ms = 5000,
    .read_timeout_ms = 30000,
    .max_redirects = 10,
    .max_body_bytes = 8 * 1024 * 1024,
    .user_agent = "search-runtime-crawler/1.0",
    .http_keepalive = true,
    .max_connections_per_host = 8,
    .dns_cache_ttl_ms = 300000,
    .connect_retries = 3,
    .retry_backoff_ms = 500,
    .conditional_requests = true,
    .compression_decode = true,
    .respect_robots = false,
    .denied_challenge_policy = "quarantine",
    .browser_enabled = false,
    .browser_render_deadline_ms = 15000,
    .browser_max_pages = 5,
    .egress_partitions = 1,
    .egress_partition_id = 0,
}
