{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Versioned GPU embedding workload",
  "type": "object",
  "additionalProperties": false,
  "required": ["model_version", "items"],
  "properties": {
    "protocol_version": {"const": 1, "default": 1},
    "model_version": {"type": "integer", "minimum": 1},
    "dimensions": {"const": 4096, "default": 4096},
    "deadline_ms": {"type": "integer", "minimum": 1, "maximum": 4294967295, "default": 60000},
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "span": {
      "type": "object", "additionalProperties": false, "required": ["start", "end"],
      "properties": {
        "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1},
        "depth": {"type": "number", "minimum": 0}, "heading": {"type": "number", "minimum": 0},
        "element": {"type": "number", "minimum": 0}, "prominence": {"type": "number", "minimum": 0},
        "paragraph": {"type": "number", "minimum": 0}, "link": {"type": "number", "minimum": 0}
      }
    },
    "item": {
      "type": "object", "additionalProperties": false, "required": ["text"],
      "properties": {
        "id": {"type": "integer", "minimum": 0}, "text": {"type": "string", "minLength": 1},
        "kind": {"enum": ["query", "document"], "default": "document"},
        "structure": {"type": "array", "items": {"$ref": "#/$defs/span"}}
      }
    }
  }
}
