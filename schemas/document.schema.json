{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DocumentInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["url", "text"],
  "properties": {
    "url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "title": {"type": "string", "default": ""},
    "text": {"type": "string", "minLength": 1},
    "language": {"type": "string", "default": ""},
    "quality": {"type": "number", "minimum": 0, "maximum": 1, "default": 1},
    "published_at": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807, "default": 0},
    "model_version": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615, "default": 1},
    "embedding": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 4096, "maxItems": 4096, "items": {"type": "number"}}], "default": null}
  }
}
