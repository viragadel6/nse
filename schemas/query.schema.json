{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SearchRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["query"],
  "properties": {
    "query": {"type": "string", "minLength": 1},
    "mode": {"enum": ["sparse", "dense", "hybrid"], "default": "hybrid"},
    "result_count": {"type": "integer", "minimum": 1, "maximum": 4294967295, "default": 10},
    "deadline_ms": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1, "maximum": 4294967295}], "default": null},
    "embedding": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 4096, "maxItems": 4096, "items": {"type": "number"}}], "default": null},
    "model_version": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615, "default": 1},
    "highlights": {"type": "boolean", "default": true},
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domains": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []},
        "language": {"type": ["null", "string"], "default": null},
        "minimum_quality": {"type": "number", "minimum": 0, "maximum": 1, "default": 0},
        "published_after": {"type": ["null", "integer"], "minimum": 0, "maximum": 9223372036854775807, "default": null},
        "published_before": {"type": ["null", "integer"], "minimum": 0, "maximum": 9223372036854775807, "default": null}
      }
    }
  }
}
