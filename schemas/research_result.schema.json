{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["job_id", "query", "status", "steps", "created_at_ms"],
    "properties": {
        "job_id": { "type": "integer", "minimum": 0 },
        "query": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "running", "completed", "failed"] },
        "steps": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["step_id", "subquery", "status"],
                "properties": {
                    "step_id": { "type": "integer", "minimum": 0 },
                    "subquery": { "type": "string" },
                    "status": { "type": "string", "enum": ["pending", "running", "completed", "failed"] },
                    "evidence_count": { "type": "integer", "minimum": 0 }
                }
            }
        },
        "created_at_ms": { "type": "integer", "minimum": 0 },
        "updated_at_ms": { "type": "integer", "minimum": 0 }
    }
}
