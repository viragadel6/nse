[Unit]
Description=Document search runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/neural_search_engine
EnvironmentFile=-/home/ubuntu/neural_search_engine/deploy/runtime.env
ExecStart=/home/ubuntu/neural_search_engine/zig-out/bin/search-node serve settings
Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
